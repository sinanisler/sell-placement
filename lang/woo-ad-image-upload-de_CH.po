msgstr "Der Geschenk-Empfänger"

#: sell-placement.php:544
msgid "{who} - customer"
msgstr "{who} – Kunde"

#: sell-placement.php:545
msgid "The customer"
msgstr "Der Kunde"

#: sell-placement.php:551
msgid "Error messages"
msgstr "Fehlermeldungen"

#: sell-placement.php:552
msgid "Shown wherever the problem happens - the product page, the private link page, or the plain form fallback."
msgstr "Wird dort angezeigt, wo das Problem auftritt – auf der Produktseite, auf der Seite mit dem privaten Link oder im einfachen Ersatzformular."

#: sell-placement.php:556
msgid "No file received"
msgstr "Keine Datei empfangen"

#: sell-placement.php:557
msgid "No file was received."
msgstr "Es wurde keine Datei empfangen."

#: sell-placement.php:561
msgid "Upload failed"
msgstr "Upload fehlgeschlagen"

#: sell-placement.php:562
msgid "The upload failed. Please try again."
msgstr "Der Upload ist fehlgeschlagen. Bitte versuchen Sie es erneut."

#: sell-placement.php:566
msgid "File too large (server)"
msgstr "Datei zu groß (Server)"

#: sell-placement.php:567
msgid "That image is too large. Please upload a file under {max_size}."
msgstr "Dieses Bild ist zu groß. Bitte laden Sie eine Datei unter {max_size} hoch."

#: sell-placement.php:572
msgid "File too large (in the browser)"
msgstr "Datei zu groß (im Browser)"

#: sell-placement.php:573
msgid "That image is too large."
msgstr "Dieses Bild ist zu groß."

#: sell-placement.php:578
msgid "Format not allowed"
msgstr "Format nicht erlaubt"

#: sell-placement.php:579
msgid "That file type is not allowed. Please choose a {formats} file."
msgstr "Dieser Dateityp ist nicht erlaubt. Bitte wählen Sie eine {formats}-Datei."

#: sell-placement.php:584
msgid "Not really an image"
msgstr "Keine echte Bilddatei"

#: sell-placement.php:585
msgid "That file doesn't look like a valid image. Please choose a {formats} file."
msgstr "Diese Datei scheint kein gültiges Bild zu sein. Bitte wählen Sie eine {formats}-Datei."

#: sell-placement.php:590
msgid "Unreadable image"
msgstr "Unlesbares Bild"

#: sell-placement.php:591
msgid "That file doesn't look like a valid image. Please choose a different file."
msgstr "Diese Datei scheint kein gültiges Bild zu sein. Bitte wählen Sie eine andere Datei."

#: sell-placement.php:595
msgid "Below the minimum dimensions"
msgstr "Unter den Mindestabmessungen"

#: sell-placement.php:596
msgid "That image is {width}x{height} pixels, which is too small. Please use at least {min_width}x{min_height} pixels."
msgstr "Dieses Bild ist {width}x{height} Pixel groß und damit zu klein. Bitte verwenden Sie mindestens {min_width}x{min_height} Pixel."

#: sell-placement.php:601
msgid "Above the maximum dimensions"
msgstr "Über den Höchstabmessungen"

#: sell-placement.php:602
msgid "That image is {width}x{height} pixels, which is too big. Please keep it within {max_width}x{max_height} pixels."
msgstr "Dieses Bild ist {width}x{height} Pixel groß und damit zu groß. Bitte bleiben Sie innerhalb von {max_width}x{max_height} Pixeln."

#: sell-placement.php:607
msgid "iPhone HEIC photo"
msgstr "iPhone-HEIC-Foto"

#: sell-placement.php:608
msgid "iPhone HEIC photos are not supported. In Settings > Camera > Formats choose \"Most Compatible\", or pick a JPEG instead."
msgstr "iPhone-HEIC-Fotos werden nicht unterstützt. Wählen Sie unter Einstellungen > Kamera > Formate die Option „Maximale Kompatibilität“ oder verwenden Sie stattdessen ein JPEG."

#: sell-placement.php:612
msgid "Server returned something unexpected"
msgstr "Der Server hat etwas Unerwartetes zurückgegeben"

