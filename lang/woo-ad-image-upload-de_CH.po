msgstr "{who} hat das Bild für Bestellung #{order_number} hochgeladen. Sie können es im wp-admin ansehen."

#: sell-placement.php:539
msgid "{who} - gift recipient"
msgstr "{who} – Geschenk-Empfänger"

#: sell-placement.php:540
