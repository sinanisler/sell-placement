#: includes/emails.php:15
msgid "Email: buyer, after payment"
msgstr "E-Mail: Käufer, nach Zahlung"

#: includes/emails.php:16
msgid "One email per paid order listing every placement with its upload link. Gift placements get their card attached as a PDF."
msgstr "Eine E-Mail pro bezahlter Bestellung mit allen Platzierungen und ihren Upload-Links. Für Geschenke wird die Karte als PDF angehängt."

#: includes/emails.php:18
msgid "Your placements for order #{order_number}"
msgstr "Ihre Platzierungen zur Bestellung #{order_number}"

#: includes/emails.php:19
msgid "Thank you for your order"
msgstr "Vielen Dank für Ihre Bestellung"

#: includes/emails.php:20
msgid ""
"<p>Hi {name},</p>\n"
"<p>your payment is confirmed. Below is a private upload link for each placement. Upload yourself, or pass a link on to someone else. You can also do this any time from your account.</p>\n"
"{placements}\n"
"<p>{account_link}</p>"
msgstr ""
"<p>Hallo {name},</p>\n"
"<p>Ihre Zahlung ist bestätigt. Unten finden Sie für jede Platzierung einen privaten Upload-Link. Laden Sie selbst hoch oder geben Sie einen Link weiter. Das geht jederzeit auch in Ihrem Konto.</p>\n"
"{placements}\n"
"<p>{account_link}</p>"

#: includes/emails.php:24
msgid "Email: gift recipient"
msgstr "E-Mail: Geschenkempfänger"

#: includes/emails.php:25
msgid "Sent to the person a gift placement is passed on to with \"Send Email\" in the account. The placement card is attached as a PDF."
msgstr "Geht an die Person, an die ein Geschenk über „E-Mail senden“ im Konto weitergegeben wird. Die Platzierungskarte ist als PDF angehängt."

#: includes/emails.php:27
msgid "{buyer_name} has given you an image placement"
msgstr "{buyer_name} hat Ihnen eine Bildplatzierung geschenkt"

#: includes/emails.php:28
msgid "A placement for you"
msgstr "Eine Platzierung für Sie"

#: includes/emails.php:29
msgid ""
"<p>Hi {name},</p>\n"
"<p>{buyer_name} has given you a placement for <strong>{product}</strong>.</p>\n"
"{message}\n"
"<p>Use the button below to upload your image. No account is needed.</p>\n"
"<p>{upload_button}</p>\n"
"<p>Your placement ID: <strong>{code}</strong></p>"
msgstr ""
"<p>Hallo {name},</p>\n"
"<p>{buyer_name} hat Ihnen eine Platzierung für <strong>{product}</strong> geschenkt.</p>\n"
"{message}\n"
"<p>Über den Button unten laden Sie Ihr Bild hoch. Ein Konto ist nicht nötig.</p>\n"
"<p>{upload_button}</p>\n"
"<p>Ihre Platzierungs-ID: <strong>{code}</strong></p>"

#: includes/emails.php:33
msgid "Email: upload link"
msgstr "E-Mail: Upload-Link"

#: includes/emails.php:34
msgid "A single upload link, sent from the approval screen (\"Email again\") when a placement is still waiting for its image."
msgstr "Ein einzelner Upload-Link, gesendet aus der Freigabe-Ansicht („Erneut mailen“), solange eine Platzierung noch auf ihr Bild wartet."

#: includes/emails.php:36
msgid "Your upload link for {product}"
msgstr "Ihr Upload-Link für {product}"

#: includes/emails.php:38
msgid ""
"<p>Hi {name},</p>\n"
"<p>here is your private upload link for <strong>{product}</strong>.</p>\n"
"<p>{upload_button}</p>\n"
"<p>Your placement ID: <strong>{code}</strong></p>"
msgstr ""
"<p>Hallo {name},</p>\n"
"<p>hier ist Ihr privater Upload-Link für <strong>{product}</strong>.</p>\n"
"<p>{upload_button}</p>\n"
"<p>Ihre Platzierungs-ID: <strong>{code}</strong></p>"

#: includes/emails.php:42
msgid "Email: image received"
msgstr "E-Mail: Bild erhalten"

#: includes/emails.php:43
msgid "Sent to the uploader right after an image arrives."
msgstr "Geht an die hochladende Person, sobald ein Bild eingetroffen ist."

#: includes/emails.php:45
msgid "Your image is being reviewed"
msgstr "Ihr Bild wird geprüft"

#: includes/emails.php:46
msgid "Image received"
msgstr "Bild erhalten"

#: includes/emails.php:47
msgid ""
"<p>Hi {name},</p>\n"
"<p>thank you, we have received your image for <strong>{product}</strong> ({code}). We check every image by hand and will email you as soon as it has been reviewed.</p>"
msgstr ""
"<p>Hallo {name},</p>\n"
"<p>vielen Dank, wir haben Ihr Bild für <strong>{product}</strong> ({code}) erhalten. Wir prüfen jedes Bild von Hand und melden uns per E-Mail, sobald es geprüft ist.</p>"

#: includes/emails.php:51
msgid "Email: new upload (staff)"
msgstr "E-Mail: neuer Upload (Team)"

#: includes/emails.php:52
msgid "Sent to the addresses under General when an image is waiting for review."
msgstr "Geht an die Adressen unter „Allgemein“, wenn ein Bild auf Prüfung wartet."

#: includes/emails.php:54
msgid "New image to review: {code}"
msgstr "Neues Bild zur Prüfung: {code}"

#: includes/emails.php:55
msgid "New image to review"
msgstr "Neues Bild zur Prüfung"

#: includes/emails.php:56
msgid ""
"<p>{name} ({uploader_email}) uploaded an image for <strong>{product}</strong>, placement {code}, order #{order_number}.</p>\n"
"<p>{image}</p>\n"
"<p><a href=\"{review_link}\">Review it now</a></p>"
msgstr ""
"<p>{name} ({uploader_email}) hat ein Bild für <strong>{product}</strong> hochgeladen, Platzierung {code}, Bestellung #{order_number}.</p>\n"
"<p>{image}</p>\n"
"<p><a href=\"{review_link}\">Jetzt prüfen</a></p>"

#: includes/emails.php:60
msgid "Email: approved"
msgstr "E-Mail: freigegeben"

#: includes/emails.php:61
msgid "Sent when an image is approved. The certificate PDF is attached."
msgstr "Geht raus, wenn ein Bild freigegeben wird. Das Zertifikat ist als PDF angehängt."

#: includes/emails.php:63 includes/settings.php:292
msgid "Your image has been approved"
msgstr "Ihr Bild wurde freigegeben"

#: includes/emails.php:64
msgid "You are in!"
msgstr "Sie sind dabei!"

#: includes/emails.php:65
msgid ""
"<p>Hi {name},</p>\n"
"<p>great news: your image for <strong>{product}</strong> has been approved. Here is your certificate. The PDF version is attached, ready to print.</p>\n"
"{certificate}\n"
"<p>Your placement ID: <strong>{code}</strong></p>"
msgstr ""
"<p>Hallo {name},</p>\n"
"<p>gute Nachrichten: Ihr Bild für <strong>{product}</strong> wurde freigegeben. Hier ist Ihr Zertifikat. Die PDF-Version zum Ausdrucken finden Sie im Anhang.</p>\n"
"{certificate}\n"
"<p>Ihre Platzierungs-ID: <strong>{code}</strong></p>"

#: includes/emails.php:69
msgid "Email: declined"
msgstr "E-Mail: abgelehnt"

#: includes/emails.php:70
msgid "Sent when an image is declined and a new one may be uploaded."
msgstr "Geht raus, wenn ein Bild abgelehnt wird und ein neues hochgeladen werden darf."

#: includes/emails.php:72
msgid "Please upload a new image for {product}"
msgstr "Bitte laden Sie ein neues Bild für {product} hoch"

#: includes/emails.php:73
msgid "We need a new image"
msgstr "Wir brauchen ein neues Bild"

#: includes/emails.php:74
msgid ""
"<p>Hi {name},</p>\n"
"<p>unfortunately we cannot use your image for <strong>{product}</strong>:</p>\n"
"<blockquote>{reason}</blockquote>\n"
"<p>Please upload a new one with the same link. Attempts left: {attempts_left}.</p>\n"
"<p>{upload_button}</p>"
msgstr ""
"<p>Hallo {name},</p>\n"
"<p>leider können wir Ihr Bild für <strong>{product}</strong> nicht verwenden:</p>\n"
"<blockquote>{reason}</blockquote>\n"
"<p>Bitte laden Sie über denselben Link ein neues hoch. Verbleibende Versuche: {attempts_left}.</p>\n"
"<p>{upload_button}</p>"

#: includes/emails.php:78
msgid "Email: suspended"
msgstr "E-Mail: gesperrt"

#: includes/emails.php:79
msgid "Sent when a placement is suspended, by hand or after too many declines."
msgstr "Geht raus, wenn eine Platzierung gesperrt wird, von Hand oder nach zu vielen Ablehnungen."

#: includes/emails.php:81
msgid "Your placement {code} has been suspended"
msgstr "Ihre Platzierung {code} wurde gesperrt"

#: includes/emails.php:82
msgid "Placement suspended"
msgstr "Platzierung gesperrt"

#: includes/emails.php:83
msgid ""
"<p>Hi {name},</p>\n"
"<p>your placement for <strong>{product}</strong> has been suspended:</p>\n"
"<blockquote>{reason}</blockquote>\n"
"<p>Please reply to this email if you have questions.</p>"
msgstr ""
"<p>Hallo {name},</p>\n"
"<p>Ihre Platzierung für <strong>{product}</strong> wurde gesperrt:</p>\n"
"<blockquote>{reason}</blockquote>\n"
"<p>Bei Fragen antworten Sie einfach auf diese E-Mail.</p>"

